APP_NAME=AI-Powered GitHub Code Review Assistant API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://ai_code_review_app:replace-with-password@localhost:5432/ai_code_review_db
GITHUB_TOKEN=replace-with-github-token
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
GEMINI_API_KEY=replace-with-gemini-api-key
